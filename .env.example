# TokenSentry Configuration
TOKENSENTRY_PORT=8080
TOKENSENTRY_HOST=127.0.0.1

# Upstream Endpoints
ANTHROPIC_UPSTREAM_URL=https://api.anthropic.com
OPENAI_UPSTREAM_URL=https://api.openai.com

# Optional: API Keys (Can also be passed dynamically by coding agent clients)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# Optional: Free-Tier Offloading (Zero Cost)
# GROQ_API_KEY=your_free_groq_api_key_here
# GEMINI_API_KEY=your_free_gemini_api_key_here

# Optimization Feature Flags
TOKENSENTRY_AST_PRUNING=true
TOKENSENTRY_FREE_FALLBACK=true
TOKENSENTRY_VERBOSE=false
